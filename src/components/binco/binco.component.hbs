<view id="binco" cmp="Binco" data-title="BinCo">
  <div class="inputs-wrapper">
    {{> components/atoms/input-area/input-area.atom
      label="text"
      inputAttributes="js-text"
    }}
  </div>
  <div class="buttons-container">
    {{> components/atoms/button/button.atom
      type="secondary"
      label="ENCODE"
      icon="chevron-down"
      attributes="js-encode"
      reverseIcon="true"
    }}
    {{> components/atoms/input-number/input-number.atom
      initialValue="1"
      inputAttributes="js-segment"
      min=1
      max=9
      controls=true
      disabled="true"
    }}
    {{> components/atoms/button/button.atom
      type="secondary"
      label="DECODE"
      icon="chevron-up"
      attributes="js-decode"
    }}
  </div>
  <div class="inputs-wrapper">
    {{> components/atoms/input-area/input-area.atom
      label="code"
      inputAttributes="js-code"
    }}
  </div>
</view>