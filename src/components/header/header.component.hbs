<header cmp="Header">
  <h1 class="header-title">Abs Webtools</h1>
  <button js-mobile-menu class="-mob">
    {{> components/atoms/micon/micon.atom
      name="menu"
    }}
    {{> components/atoms/micon/micon.atom
      name="close"
      classes="hidden"
    }}
  </button>
  <div class="header-list -dsk" js-menu-dsk></div>
  <div class="header-list -mob">
    <button js-mobile-menu-search class="disabled">
      {{> components/atoms/micon/micon.atom
        name="search"
      }}
    </button>
    <div class="header-list-scroll-container">
      <div class="header-list-track" js-menu-mob></div>
    </div>
  </div>

  <template id="header-list-item">
    <button data-target-id="[[targetId]]" class="header-list-item">[[label]]</button>
  </template>
</header>
