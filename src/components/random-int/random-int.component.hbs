<view id="random-int" cmp="RandomInt" data-title="Random Int">
  <div class="inputs-wrapper">
    {{> components/atoms/input-number-range/input-number-range.atom
      label="range"
      firstInitialValue="0"
      firstInputAttributes="js-min"
      firstControls=true
      secondInitialValue="1"
      secondInputAttributes="js-max"
      secondControls=true
    }}
  </div>
  {{> components/atoms/button/button.atom
    type="secondary"
    label="GENERATE"
    attributes="js-generate"
  }}
  {{> components/atoms/input-text/input-text.atom
    label="result"
    inputAttributes="js-generate-output readonly"
  }}
</view>