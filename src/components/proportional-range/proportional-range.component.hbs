<view id="proportional-range" cmp="ProportionalRange" data-title="Proportional Range">
  <div class="inputs-wrapper">
    <fieldset>
      <legend>initial range</legend>
      {{> components/atoms/input-number/input-number.atom
        initialValue="0"
        inputAttributes="js-old-min"
        controls=true
      }}
      {{> components/atoms/input-number/input-number.atom
        initialValue="100"
        inputAttributes="js-old-max"
        controls=true
      }}
    </fieldset>
    <fieldset>
      <legend>new range</legend>
      {{> components/atoms/input-number/input-number.atom
        initialValue="0"
        inputAttributes="js-new-min"
        controls=true
      }}
      {{> components/atoms/input-number/input-number.atom
        initialValue="1"
        inputAttributes="js-new-max"
        controls=true
      }}
    </fieldset>
    <fieldset>
      <legend>value</legend>
      {{> components/atoms/input-number/input-number.atom
        initialValue="1"
        inputAttributes="js-value"
        controls=true
      }}
    </fieldset>
  </div>



  {{!-- <input type="number" value="0" js-old-min />
  <input type="number" value="100" js-old-max />
  <input type="number" value="0" js-new-min />
  <input type="number" value="1" js-new-max />
  <input type="number" value="1" js-value></div> --}}
  
  {{> components/atoms/button/button.atom
    type="secondary"
    label="CALCULATE"
    attributes="js-calculate"
  }}

  {{!-- <input class="input" type="text" js-calculation-output /> --}}
  {{> components/atoms/input-text/input-text.atom
    inputAttributes="js-calculation-output"
  }}
</view>