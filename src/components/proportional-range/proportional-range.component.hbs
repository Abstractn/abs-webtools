<view id="proportional-range" cmp="ProportionalRange" data-title="Proportional Range">
  <div class="inputs-wrapper">
    {{> components/atoms/input-number-range/input-number-range.atom
      label="initial range"
      firstInitialValue="0"
      firstInputAttributes="js-old-min"
      firstControls=true
      secondInitialValue="100"
      secondInputAttributes="js-old-max"
      secondControls=true
    }}
    {{> components/atoms/input-number-range/input-number-range.atom
      label="new range"
      firstInitialValue="0"
      firstInputAttributes="js-new-min"
      firstControls=true
      secondInitialValue="1"
      secondInputAttributes="js-new-max"
      secondControls=true
    }}
    {{> components/atoms/input-number/input-number.atom
      label="value"
      initialValue="1"
      inputAttributes="js-value"
      controls=true
    }}
  </div>
  
  {{> components/atoms/button/button.atom
    type="secondary"
    label="CALCULATE"
    attributes="js-calculate"
  }}

  {{> components/atoms/input-text/input-text.atom
    label="new value"
    inputAttributes="js-calculation-output readonly"
  }}
</view>