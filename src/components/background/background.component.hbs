<component cmp="Background">
  {{#ifCond type '==' 'image'}}
    <div class="page-background"></div>
  {{/ifCond}}
  {{#ifCond type '==' 'svg'}}
    <bg>
      <bge back></bge>
      <bge meat></bge>
      <bge blue></bge>
      <bge purple></bge>
      <bge rose></bge>
      <bge salmon></bge>
      <bge cream></bge>
    </bg>
  {{/ifCond}}
</component>