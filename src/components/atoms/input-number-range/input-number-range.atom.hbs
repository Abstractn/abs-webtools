<component
  cmp="InputNumberRange"
  class="{{classes}} {{#if disabled}}disabled{{/if}}"
>
  {{#if label}}<label>{{label}}</label>{{/if}}
  <div class="inputs-container">
    {{> components/atoms/input-number/input-number.atom
      label=""
      initialValue=firstInitialValue
      inputAttributes=firstInputAttributes
      min=firstMin
      max=firstMax
      controls=firstControls
      classes=firstClasses
      disabled=disabled
    }}
    {{> components/atoms/input-number/input-number.atom
      label=""
      initialValue=secondInitialValue
      inputAttributes=secondInputAttributes
      min=secondMin
      max=secondMax
      controls=secondControls
      classes=secondClasses
      disabled=disabled
    }}
  </div>
</component>