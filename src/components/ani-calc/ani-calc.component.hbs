<view id="ani-calc" cmp="AniCalc" data-title="AniCalc">
  <div class="double-input-container">
    {{> components/atoms/input-date/input-date.atom
      label="airing start date"
      inputAttributes="js-start"
    }}
    {{> components/atoms/input-number/input-number.atom
      label="number of episodes"
      inputAttributes="js-duration"
      initialValue="12"
      controls="true"
    }}
  </div>
  <div class="double-input-container">
    {{> components/atoms/input-number/input-number.atom
      label="release frequency (days)"
      disabled="true"
      inputAttributes="js-release-frequency"
      initialValue="7"
      controls="true"
    }}
    {{> components/atoms/input-number/input-number.atom
      label="watch frequency (per day)"
      inputAttributes="js-watch-frequency"
      initialValue="1"
      controls="true"
      min=1
    }}
  </div>

  {{> components/atoms/button/button.atom
    type="secondary"
    label="CALCULATE"
    attributes="js-calculate"
  }}

  <div class="double-input-container">
    {{> components/atoms/input-text/input-text.atom
      label="begin"
      inputAttributes="js-result readonly"
    }}
    {{> components/atoms/input-text/input-text.atom
      label="estimated end date"
      inputAttributes="js-end readonly"
    }}
  </div>
</view>